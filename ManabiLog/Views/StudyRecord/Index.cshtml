@model IEnumerable<ManabiLog.Models.StudyRecord>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @* modelはStudyRecord モデル *@
                @Html.DisplayNameFor(model => model.StudyDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tags)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Content)
            </th>
            <th>
                Button
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
    <tr data-detail-id="study-detail-@item.Id">
        <td>
            @* 引数 model の型は IEnumerable<StudyRecord>らしい *@
            @* DisplayForの引数は、@model で指定した型になる *@
            @Html.DisplayFor(model => item.StudyDate)
        </td>
        <td>
            @Html.DisplayFor(model => item.Title)
        </td>
        <td>
            @* item.TagsのデータはList形式。Listに保存されているタグを全て表示したい *@
            @* @Html.DisplayFor(model => item.Tags) *@
                @foreach(var tag in item.Tags)
                {
                    <span class="badge text-bg-primary">#@Html.DisplayFor(model => tag.Name)</span>
                }
        </td>
        <td>
            @Html.DisplayFor(model => item.Content)
        </td>
        <td>
            @Html.DisplayFor(model => item.Learned)
        </td>
        <td>
            @Html.DisplayFor(model => item.Memo)
        </td>
        <td>
            <a asp-action="Edit" id="1" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="Details" id="2" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Delete" id="3" asp-route-id="@item.Id">Delete</a>
        </td>
    </tr>
    <tr class="" id="study-detail-@item.Id" hidden>
        <td colspan="6">
            @* 引数 model の型は IEnumerable<StudyRecord>らしい *@
            @* DisplayForの引数は、@model で指定した型になる *@
            @Html.DisplayFor(model => item.StudyDate)
            @Html.DisplayFor(model => item.Title)
                @* item.TagsのデータはList形式。Listに保存されているタグを全て表示したい *@
            @* @Html.DisplayFor(model => item.Tags) *@
                @foreach(var tag in item.Tags)
                {
                    <span class="badge text-bg-primary">#@Html.DisplayFor(model => tag.Name)</span>
                }
            @Html.DisplayFor(model => item.Content)
            @Html.DisplayFor(model => item.Learned)
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
        </td>
    </tr>
        
                
}
    </tbody>
</table>


<div class="accordion" id="accordionExample">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">アイテム1つ目</button>
        </h2>
        @* データの中身を追加↓ *@
    </div>
</div>